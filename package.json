{
  "name": "@trishchuk/bun-nestjs-adapter",
  "version": "0.1.0",
  "description": "Native Bun.serve adapter for NestJS — HTTP, WebSocket, SSE, streaming, file uploads.",
  "license": "MIT",
  "author": "Taras Trishchuk <taras@trishchuk.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x51xxx/bun-nestjs-adapter.git"
  },
  "homepage": "https://github.com/x51xxx/bun-nestjs-adapter#readme",
  "bugs": "https://github.com/x51xxx/bun-nestjs-adapter/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./tests/preload.ts tests/",
    "test:integration": "bun test --preload ./tests/preload.ts tests/integration/",
    "test:fixtures": "bun test --preload ./tests/preload.ts tests/integration/upstream-fixtures.spec.ts",
    "bench": "bun run tests/bench/bun-bench.ts",
    "bench:quick": "bun run tests/bench/bun-bench.ts --duration 5 --connections 50",
    "bench:rest": "bun run tests/bench/rest-bench-k6.ts",
    "bench:matrix": "bun run tests/bench/run-matrix.ts",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "fixtures:install": "bash scripts/fixtures-install.sh",
    "fixtures:update": "bash scripts/fixtures-update.sh",
    "release": "changeset publish",
    "version": "changeset version",
    "prepare": "husky",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/websockets": "^10.0.0 || ^11.0.0",
    "ejs": "^3.0.0 || ^4.0.0 || ^5.0.0 || ^6.0.0",
    "handlebars": "^4.0.0",
    "pug": "^3.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/websockets": {
      "optional": true
    },
    "ejs": {
      "optional": true
    },
    "handlebars": {
      "optional": true
    },
    "pug": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.1.2",
    "@as-integrations/fastify": "^3.1.0",
    "@biomejs/biome": "^1.9.4",
    "@casl/ability": "^7.0.0",
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@graphql-yoga/nestjs": "^3.22.1",
    "@nestjs/apollo": "^13.4.0",
    "@nestjs/common": "^11.1.10",
    "@nestjs/core": "^11.1.10",
    "@nestjs/graphql": "^13.4.0",
    "@nestjs/platform-express": "^11.1.10",
    "@nestjs/platform-fastify": "^11.1.10",
    "@nestjs/testing": "^11.1.10",
    "@nestjs/websockets": "^11.1.10",
    "@swc/core": "^1.10.0",
    "@trishchuk/nest-casl": "^1.1.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.10.0",
    "casl": "^1.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ejs": "^6.0.1",
    "express": "^5.2.0",
    "fastify": "^5.8.0",
    "graphql": "^16.13.2",
    "graphql-yoga": "^5.21.1",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "pug": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,js,json}": ["biome check --write --no-errors-on-unmatched"]
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nestjs",
    "bun",
    "adapter",
    "platform-bun",
    "http",
    "websocket",
    "sse",
    "streaming",
    "performance"
  ]
}
